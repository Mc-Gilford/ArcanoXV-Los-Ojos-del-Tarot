  m_Script: {fileID: 11500000, guid: fdcb968fe8daeb841b505692d8ae57ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HintCard
  distanciaInteraccion: 3
  tiempoTransicion: 0.5
  textoPista: "La noche del solsticio, el c\xEDrculo se cerr\xF3. Trece velas. Trece
    cartas. Trece susurros.\n\n\"El Arcano XV despertar\xE1 cuando la sangre de la
    linaje toque el pentagrama.\"\n\nYo no estuve all\xED. Pero las cartas me lo
    mostraron. Vi a Hazel de rodillas, las manos sangrando sobre el altar. Vi a Madame
    Zara sonriendo con dientes afilados. Vi el momento en que el mundo se parti\xF3
    en dos."
  tamanoLetra: 26
  colorTexto: {r: 0.12, g: 0.08, b: 0.04, a: 1}
  tamanoPanel: {x: 600, y: 800}
  tamanoTextoArea: {x: 500, y: 700}
  posicionPanel: {x: 0, y: 0}
  posicionTexto: {x: 0, y: 0}
