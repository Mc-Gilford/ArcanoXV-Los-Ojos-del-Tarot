  m_Script: {fileID: 11500000, guid: fdcb968fe8daeb841b505692d8ae57ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HintCard
  distanciaInteraccion: 3
  tiempoTransicion: 0.5
  textoPista: "Notas. Miles de notas. Mi letra. No mi letra. La de Hazel. La de Madame
    Zara. Todas mezcladas.\n\nLa verdad duele: nuestra abuela no muri\xF3 de vieja.
    La sacrific\xF3 Zara para sellar el primer c\xEDrculo. Y mi madre... mi madre
    lo sab\xEDa. Lo permiti\xF3. Por poder. Por el don.\n\nHazel no es mi hermana.
    Es mi reemplazo. La siguiente en la l\xEDnea."
  tamanoLetra: 26
  colorTexto: {r: 0.12, g: 0.08, b: 0.04, a: 1}
  tamanoPanel: {x: 600, y: 800}
  tamanoTextoArea: {x: 500, y: 700}
  posicionPanel: {x: 0, y: 0}
  posicionTexto: {x: 0, y: 0}
