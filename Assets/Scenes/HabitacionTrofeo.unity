--- !u!114 &1559178205
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1559178204}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fdcb968fe8daeb841b505692d8ae57ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HintCard
  distanciaInteraccion: 3
  tiempoTransicion: 0.5
  textoPista: "Mi abuela me lo dijo la noche antes de morir: \"El tarot no predice
    el futuro, ni\xF1a. Lo escribe.\"\n\nNo entend\xED sus palabras hasta que encontr\xE9
    el mazo en el desv\xE1n. Cartas que brillaban con luz propia, que susurraban
    al tocarlas. La primera vez que saqu\xE9 una, el aire se hel\xF3 y vi... vi cosas
    que no deber\xEDan verse.\n\nAhora s\xE9 que el don no es un regalo. Es una condena.
    Y mi hermana Hazel la ha heredado."
  tamanoLetra: 2
  colorTexto: {r: 0.12, g: 0.08, b: 0.04, a: 1}
  tamanoPanel: {x: 800, y: 900}
  tamanoTextoArea: {x: 300, y: 700}
  posicionPanel: {x: 0, y: 0}
  posicionTexto: {x: 0, y: 0}
